\def\firstbeforepreface{
    \pagenumbering{roman}
    \pagestyle{plain}
    \begin{tikzpicture}[remember picture, overlay]
      \draw[line width = 1pt] ($(current page.north west) + (98pt,-65pt)$) rectangle ($(current page.south east) + (-46pt,56pt)$);
    \end{tikzpicture}
    \firsttitlep
    \cleardoublepage
}
        
\def\prefacesection#1{
    \chapter*{#1}
